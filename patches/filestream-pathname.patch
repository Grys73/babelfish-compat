+/* FILESTREAM <column>.PathName(): is the would-be schema of the call a real schema? (see exitFunction_call) */
+static bool
+pathname_schema_exists(TSqlParser::Func_proc_name_server_database_schemaContext *fpnsds)
+{
+	std::string db = fpnsds->database ? stripQuoteFromId(fpnsds->database) : std::string(get_cur_db_name());
+	char *physical = get_physical_schema_name(pstrdup(db.c_str()), stripQuoteFromId(fpnsds->schema).c_str());
+	bool exists = physical && physical[0] && OidIsValid(get_namespace_oid(physical, true));
+	if (physical) pfree(physical);
+	return exists;
+}
