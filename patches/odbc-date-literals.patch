+	 * ODBC date literals {d 'yyyy-mm-dd'} and {ts 'yyyy-mm-dd hh:mi:ss[.fff]'} are datetime values in
+	 * the ODBC canonical format on SQL Server, whatever the session language: CONVERT style 121.
+	 */
+	void exitOdbc_literal(TSqlParser::Odbc_literalContext *ctx) override
