+/*
+ * sp_* parameters are taken as raw text, without the query rewrites: convert ODBC {d '...'} / {ts '...'}
+ * here like exitOdbc_literal does for expressions.
+ */
+static std::string
+execParamText(TSqlParser::Execute_parameterContext *exec_param)
+{
+	auto octx = exec_param->odbc_literal();
+
+	if (octx && octx->op && (octx->op->getType() == TSqlParser::D || octx->op->getType() == TSqlParser::TS) && octx->char_string())
+		return "CONVERT(DATETIME, " + ::getFullText(octx->char_string()) + ", 121)";
+	return ::getFullText(exec_param);
+}
