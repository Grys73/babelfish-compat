+/*
+ * PeekFirstByte - the connection's first byte, left in the socket.
+ * Returns -1 on EOF or error.
+ */
+static int
+PeekFirstByte(Port *port)
+{
+	unsigned char b;
+
+	for (;;)
+	{
+		ssize_t		n = recv(port->sock, &b, 1, MSG_PEEK);
+
+		if (n == 1)
+			return b;
+		if (n == 0)
+			return -1;
+		if (errno == EINTR)
+			continue;
+		if (errno != EAGAIN && errno != EWOULDBLOCK)
+			return -1;
+
+		(void) WaitLatchOrSocket(MyLatch,
+								 WL_SOCKET_READABLE | WL_LATCH_SET | WL_EXIT_ON_PM_DEATH,
+								 port->sock, -1, WAIT_EVENT_CLIENT_READ);
+		ResetLatch(MyLatch);
+		CHECK_FOR_INTERRUPTS();
+	}
+}
