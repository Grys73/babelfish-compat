@@ -2010,6 +2063,45 @@ TdsProcessLogin(Port *port, bool loadedSsl)
 	TdsErrorContext->phase = 0;
 	TdsErrorContext->reqType = TDS_LOGIN7;
 
+	/*
+	 * TDS 8.0 strict encryption: a TLS handshake record (0x16) instead of a
+	 * PRELOGIN packet (0x12) as the first byte.  Do the handshake now, on the
+	 * raw socket; PRELOGIN and LOGIN7 then arrive inside TLS.  Errors here go
+	 * only to the server log: the client can read neither TDS nor plaintext.
+	 */
+	TdsStrictHandshake = false;
+	if (port->laddr.addr.ss_family != AF_UNIX)
+	{
+		int			first = PeekFirstByte(port);
+
+		if (first < 0)
+			return -1;
+		if (first == 0x16)
+		{
+			if (!loadedSsl)
+			{
+				ereport(COMMERROR,
+						(errcode(ERRCODE_PROTOCOL_VIOLATION),
+						 errmsg("TDS 8.0 strict connection refused: SSL is not enabled"),
+						 errhint("Set ssl = on and ssl_cert_file/ssl_key_file.")));
+				return -1;
+			}
+			TdsStrictHandshake = true;
+			TdsErrorContext->err_text = "TDS 8.0 strict TLS handshake";
+			rc = SecureOpenServer(port);
+			if (rc < 0)
+				return rc;
+		}
+		else if (tds_ssl_strict_only)
+		{
+			ereport(COMMERROR,
+					(errcode(ERRCODE_PROTOCOL_VIOLATION),
+					 errmsg("connection refused: babelfishpg_tds.tds_ssl_strict_only is on and the client did not use TDS 8.0 strict encryption"),
+					 errhint("Connect with Encrypt=Strict.")));
+			return -1;
+		}
+	}
+
 	PG_TRY();
 	{
 		TdsErrorContext->err_text = "Parsing PreLogin Request";
