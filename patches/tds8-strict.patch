+/*
+ * ALPN selection: a TDS 8.0 strict client offers "tds/8.0".  A strict client
+ * that offers only other protocols is refused; elsewhere ALPN is ignored.
+ */
+static int
+tds_alpn_select_cb(SSL *ssl, const unsigned char **out, unsigned char *outlen,
+				   const unsigned char *in, unsigned int inlen, void *arg)
+{
+	static const unsigned char tds_alpn[] = "\x07tds/8.0";
+
+	if (SSL_select_next_proto((unsigned char **) out, outlen,
+							  tds_alpn, sizeof(tds_alpn) - 1,
+							  in, inlen) == OPENSSL_NPN_NEGOTIATED)
+		return SSL_TLSEXT_ERR_OK;
+
+	return TdsStrictHandshake ? SSL_TLSEXT_ERR_ALERT_FATAL : SSL_TLSEXT_ERR_NOACK;
+}
