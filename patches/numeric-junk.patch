+
+/*
+ * babelfish-compat patch: numeric-junk. Length of the number at the start of a
+ * "trailing junk" token (digits, a decimal point, an exponent), so T-SQL can
+ * take 111THEN or 1.5AS as a number followed by a word, as SQL Server does.
+ */
+static int
+tsql_number_prefix(const char *text)
+{
+	int			n = 0;
+
+	while (isdigit((unsigned char) text[n]) || text[n] == '.')
+		n++;
+	if ((text[n] == 'e' || text[n] == 'E') &&
+		(isdigit((unsigned char) text[n + 1]) ||
+		 ((text[n + 1] == '+' || text[n + 1] == '-') && isdigit((unsigned char) text[n + 2]))))
+	{
+		n += (text[n + 1] == '+' || text[n + 1] == '-') ? 2 : 1;
+		while (isdigit((unsigned char) text[n]))
+			n++;
+	}
+	return n;
+}
