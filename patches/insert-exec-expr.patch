+
+/*
+ * INSERT ... EXEC (<code>) (insert-exec-expr patch). A string literal runs as
+ * an inline code block, as before. Any other expression, e.g.
+ * EXEC ('select ' + @col + ' from dbo.' + @tbl) or EXEC (@sql), was a syntax
+ * error; it calls sys.bbf_compat_insert_exec(@sql), whose EXEC (@sql) hands its rows
+ * to the INSERT (insert-exec-batch patch), with the variables resolved like
+ * any procedure argument.
+ */
+static Node *
+tsql_insert_exec_expr(Node *code, int exec_loc, int code_loc)
+{
+	if (IsA(code, A_Const) && !((A_Const *) code)->isnull &&
+		nodeTag(&((A_Const *) code)->val) == T_String)
+	{
+		DoStmt	   *n = makeNode(DoStmt);
+
+		n->args = list_make1(makeDefElem("as",
+										 (Node *) makeString(((A_Const *) code)->val.sval.sval),
+										 code_loc));
+		return (Node *) n;
+	}
+	else
+	{
+		CallStmt   *n = makeNode(CallStmt);
+
+		n->funccall = makeFuncCall(list_make2(makeString("sys"), makeString("bbf_compat_insert_exec")),
+								   list_make1(code), COERCE_EXPLICIT_CALL, exec_loc);
+		return (Node *) n;
+	}
+}
