+/*
+ * temp-owner patch: change_object_owner_if_db_owner() runs REASSIGN OWNED BY
+ * <user> TO <user>_bbfobj after every new object of a db_owner member. For
+ * "create table #t(id int identity)" or "declare @t table(id int identity,
+ * c int default 0)" the identity sequence, created first, was moved to
+ * <user>_bbfobj by the sequence's, row types' or default's hook while the
+ * temporary table stayed the user's, so OWNED BY failed: "sequence must have
+ * same owner as table it is linked to". Temporary objects are the session's
+ * own and stay with the user; defaults and constraints have no owner (their
+ * table's own hook has reassigned already).
+ */
+static bool
+skip_db_owner_reassign(Oid classId, Oid objectId)
+{
+	Oid			nsp = InvalidOid;
+
+	if (classId == AttrDefaultRelationId || classId == ConstraintRelationId)
+		return true;
+
+	/* a lookup that misses (new permanent tuple not visible yet) reassigns as before */
+	if (classId == RelationRelationId)
+		nsp = get_rel_namespace(objectId);
+	else if (classId == TypeRelationId)
+	{
+		HeapTuple	tup = SearchSysCache1(TYPEOID, ObjectIdGetDatum(objectId));
+
+		if (HeapTupleIsValid(tup))
+		{
+			nsp = ((Form_pg_type) GETSTRUCT(tup))->typnamespace;
+			ReleaseSysCache(tup);
+		}
+	}
+
+	return OidIsValid(nsp) && isAnyTempNamespace(nsp);
+}
