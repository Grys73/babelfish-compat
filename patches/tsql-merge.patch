+/*
+ * MERGE (tsql-merge patch). PostgreSQL 17 has MERGE with WHEN NOT MATCHED [BY TARGET] / BY SOURCE,
+ * RETURNING and merge_action(); the T-SQL statement differs from it only in the places rewritten here:
+ *  - INTO is optional in T-SQL;
+ *  - table hints on the target and on the source (WITH (HOLDLOCK) of the upsert idiom) and OPTION (...)
+ *    are dropped like in UPDATE/DELETE: PostgreSQL locks the target rows it matches and has no key-range
+ *    locks;
+ *  - OUTPUT becomes RETURNING: inserted.c is the target row after the action and deleted.c the target row
+ *    of a DELETE (NULL for the rows of the other actions, as on SQL Server); PostgreSQL 17 cannot return the
+ *    row before an UPDATE, so deleted.* together with WHEN MATCHED THEN UPDATE is refused; $action is
+ *    merge_action() ('INSERT' / 'UPDATE' / 'DELETE', the same strings);
+ *  - OUTPUT ... INTO t [(cols)] becomes WITH bbf_merge_output AS (MERGE ... RETURNING ...)
+ *    INSERT INTO t [(cols)] SELECT * FROM bbf_merge_output (EF Core's batched insert uses OUTPUT INTO @t).
+ * Qualified SET targets (SET target.c = ...) are resolved later like in UPDATE.
+ */
+static void
+collect_terminals(antlr4::tree::ParseTree *tree, std::vector<antlr4::tree::TerminalNode *> &out)
+{
+	for (auto child : tree->children)
+	{
+		if (auto term = dynamic_cast<antlr4::tree::TerminalNode *>(child))
+			out.push_back(term);
+		else
+			collect_terminals(child, out);
+	}
+}
