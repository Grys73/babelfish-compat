+static void
+process_merge_statement(TSqlParser::Merge_statementContext *mctx, PLtsql_expr_query_mutator *mutator)
+{
+	PLtsql_expr *sqlstmt = mutator->expr;
+	bool		has_insert = false;
+	bool		has_update = false;
+	bool		has_delete = false;
+	std::string target;
+
+	if (mctx->TOP())
+		throw PGErrorWrapperException(ERROR, ERRCODE_FEATURE_NOT_SUPPORTED, "MERGE TOP is not supported in Babelfish", getLineAndPos(mctx->TOP()));
+
+	for (auto wctx : mctx->when_matches())
+	{
+		if (wctx->merge_not_matched())
+			has_insert = true;
+		else if (wctx->merge_matched() && wctx->merge_matched()->DELETE())
+			has_delete = true;
+		else if (wctx->merge_matched())
+		{
+			has_update = true;
+			for (auto ectx : wctx->merge_matched()->update_elem_merge())
+				if (ectx->LOCAL_ID() || ectx->udt_column_name)
+					throw PGErrorWrapperException(ERROR, ERRCODE_FEATURE_NOT_SUPPORTED, "MERGE ... UPDATE SET of a variable or a method call is not supported in Babelfish", getLineAndPos(ectx));
+		}
+	}
+
+	if (!mctx->INTO())
+		mutator->add(mctx->MERGE()->getSymbol()->getStopIndex() + 1, "", " INTO");
+
+	if (mctx->with_table_hints())
+		removeCtxStringFromQuery(sqlstmt, mctx->with_table_hints(), mutator->ctx);
+	if (mctx->as_table_alias())
+	{
+		target = ::getFullText(mctx->as_table_alias()->table_alias()->id());
+		if (mctx->as_table_alias()->table_alias()->with_table_hints())
+			removeCtxStringFromQuery(sqlstmt, mctx->as_table_alias()->table_alias()->with_table_hints(), mutator->ctx);
+	}
+	else if (mctx->ddl_object()->full_object_name())
+		target = ::getFullText(mctx->ddl_object()->full_object_name()->object_name);
+	else
+		target = ::getFullText(mctx->ddl_object());
+
+	if (mctx->table_sources())
+		for (auto tctx : mctx->table_sources()->table_source_item())
+			post_process_table_source(tctx, sqlstmt, mutator->ctx);
+
+	if (mctx->option_clause())
+	{
+		removeCtxStringFromQuery(sqlstmt, mctx->option_clause(), mutator->ctx);
+		extractQueryHintsFromOptionClause(mctx->option_clause());
+	}
+
+	auto octx = mctx->output_clause();
+	if (!octx)
+		return;
+	if (octx->output_clause())
+		throw PGErrorWrapperException(ERROR, ERRCODE_FEATURE_NOT_SUPPORTED, "MERGE with more than one OUTPUT clause is not supported in Babelfish", getLineAndPos(octx->output_clause()));
+
+	mutator->add(octx->OUTPUT()->getSymbol()->getStartIndex(), octx->OUTPUT()->getText(), "RETURNING");
+	for (auto elem : octx->output_dml_list_elem())
+	{
+		std::vector<antlr4::tree::TerminalNode *> toks;
+		bool		bare = elem->output_column_name() && !elem->as_column_alias();	/* the column is the whole element */
+
+		collect_terminals(elem, toks);
+		for (size_t i = 0; i < toks.size(); i++)
+		{
+			antlr4::Token *tok = toks[i]->getSymbol();
+			bool		ins = tok->getType() == TSqlParser::INSERTED;
+			bool		del = tok->getType() == TSqlParser::DELETED;
+
+			if (tok->getType() == TSqlParser::DOLLAR_ACTION)
+			{
+				mutator->add(tok->getStartIndex(), tok->getText(), bare ? "CAST(merge_action() AS NVARCHAR(10)) AS [$action]" : "CAST(merge_action() AS NVARCHAR(10))");
+				continue;
+			}
+			if (!(ins || del) || i + 2 >= toks.size() || toks[i + 1]->getSymbol()->getType() != TSqlParser::DOT)
+				continue;
+
+			antlr4::Token *col = toks[i + 2]->getSymbol();
+			bool		star = col->getType() == TSqlParser::STAR;
+
+			if (del && has_update)
+				throw PGErrorWrapperException(ERROR, ERRCODE_FEATURE_NOT_SUPPORTED, "OUTPUT deleted in a MERGE that updates is not supported in Babelfish (PostgreSQL 17 cannot return the row before an UPDATE)", getLineAndPos(elem));
+			/* every row of the statement has this pseudo table: the target row is it */
+			if (ins ? !has_delete : !has_insert)
+				mutator->add(tok->getStartIndex(), tok->getText(), target);
+			else if (star)
+				throw PGErrorWrapperException(ERROR, ERRCODE_FEATURE_NOT_SUPPORTED, "OUTPUT inserted.* or deleted.* in a MERGE that both inserts and deletes is not supported in Babelfish", getLineAndPos(elem));
+			else
+			{
+				mutator->add(tok->getStartIndex(), tok->getText(),
+							 std::string("(CASE WHEN merge_action() ") + (ins ? "<>" : "=") + " 'DELETE' THEN " + target);
+				mutator->add(col->getStopIndex() + 1, "", bare ? " END) AS " + col->getText() : std::string(" END)"));
+			}
+			i += 2;
+		}
+	}
+
+	if (octx->INTO())
+	{
+		size_t		from = octx->INTO()->getSymbol()->getStartIndex();
+		size_t		to = octx->getStop()->getStopIndex();
+		std::string into = octx->LOCAL_ID() ? "\"" + octx->LOCAL_ID()->getText() + "\"" : ::getFullText(octx->table_name());
+
+		if (octx->column_name_list())
+			into += " (" + ::getFullText(octx->column_name_list()) + ")";
+		/* the INTO part moves behind the MERGE: drop other rewrites inside it (the local id quoting) */
+		for (auto it = local_id_positions.begin(); it != local_id_positions.end();)
+			it = (it->first >= from && it->first <= to) ? local_id_positions.erase(it) : std::next(it);
+		for (auto it = rewritten_query_fragment.begin(); it != rewritten_query_fragment.end();)
+			it = (it->first >= from && it->first <= to) ? rewritten_query_fragment.erase(it) : std::next(it);
+		replaceTokenStringFromQuery(sqlstmt, octx->INTO()->getSymbol(), octx->getStop(), NULL, mutator->ctx);
+		mutator->add(mctx->MERGE()->getSymbol()->getStartIndex(), "",
+					 mctx->with_expression() ? ", bbf_merge_output AS (" : "WITH bbf_merge_output AS (");
+		mutator->add(to + 1, "", ") INSERT INTO " + into + " SELECT * FROM bbf_merge_output");
+	}
+}
