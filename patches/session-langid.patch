+/*
+ * babelfish-compat patch: session-langid. @@langid as a number kept in the
+ * session: babelfishpg_tsql.langid (read only) is SQL Server's langid of the
+ * session language. It is set wherever the language is (login language, SET
+ * LANGUAGE, connection reset, the rollback of a SET), so sys.langid() only
+ * reads it and stays a single inlinable expression. The index in
+ * sqlserver_languages (session-language.patch) is the langid; check_language
+ * has made the name canonical already. A name not listed counts as us_english.
+ */
+static void
+assign_language_langid(const char *newval, void *extra)
+{
+	int			langid = 0;
+
+	for (int i = 0; newval != NULL && i < lengthof(sqlserver_languages); i++)
+	{
+		if (pg_strcasecmp(newval, sqlserver_languages[i].name) == 0 ||
+			pg_strcasecmp(newval, sqlserver_languages[i].alias) == 0)
+		{
+			langid = i;
+			break;
+		}
+	}
+	pltsql_langid = langid;
+	assign_language(newval, extra);
+}
