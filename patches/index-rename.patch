+extern const char *ATTOPTION_BBF_ORIGINAL_TABLE_NAME;
+
+/*
+ * T-SQL index names are unique per table, PostgreSQL ones per schema, so
+ * Babelfish stores an index as construct_unique_index_name(index, table) and
+ * finds it the same way (DROP INDEX ix ON t, sp_rename 't.ix', ..., 'INDEX').
+ * A table rename kept the old table name in its index names, and those
+ * lookups failed afterwards (an EF Core migration renames a table and then
+ * its index). Rename the indexes to the names of the new table as well
+ * (index-rename patch). Indexes whose name was not built that way (those of
+ * constraints) stay as they are.
+ */
+static void
+rename_table_indexes(const char *schema_name, const char *old_name, const char *new_name)
+{
+	char	   *old_rel = downcase_truncate_identifier(old_name, strlen(old_name), false);
+	char	   *new_rel = downcase_truncate_identifier(new_name, strlen(new_name), false);
+	char	   *phys_schema = get_physical_schema_name(get_cur_db_name(), lowerstr(schema_name));
+	Oid			nspid = get_namespace_oid(phys_schema, true);
+	Oid			relid = OidIsValid(nspid) ? get_relname_relid(new_rel, nspid) : InvalidOid;
+	Relation	rel;
+	List	   *indexes;
+	ListCell   *lc;
+
+	if (!OidIsValid(relid))
+		return;
+	rel = table_open(relid, AccessShareLock);
+	indexes = RelationGetIndexList(rel);
+	table_close(rel, AccessShareLock);
+
+	foreach(lc, indexes)
+	{
+		Oid			indoid = lfirst_oid(lc);
+		HeapTuple	tup = SearchSysCache1(RELOID, ObjectIdGetDatum(indoid));
+		char	   *new_index_name = NULL;
+		Datum		opts;
+		bool		isnull;
+
+		if (!HeapTupleIsValid(tup))
+			continue;
+		opts = SysCacheGetAttr(RELOID, tup, Anum_pg_class_reloptions, &isnull);
+		if (!isnull)
+		{
+			ListCell   *oc;
+
+			foreach(oc, untransformRelOptions(opts))
+			{
+				DefElem    *def = (DefElem *) lfirst(oc);
+				char	   *logical;
+
+				if (strcmp(def->defname, ATTOPTION_BBF_ORIGINAL_TABLE_NAME) != 0)
+					continue;
+				logical = defGetString(def);
+				logical = downcase_truncate_identifier(logical, strlen(logical), false);
+				if (strcmp(NameStr(((Form_pg_class) GETSTRUCT(tup))->relname),
+						   construct_unique_index_name(logical, old_rel)) == 0)
+					new_index_name = construct_unique_index_name(logical, new_rel);
+				break;
+			}
+		}
+		ReleaseSysCache(tup);
+		if (new_index_name != NULL)
+		{
+			RenameRelationInternal(indoid, new_index_name, false, true);
+			CommandCounterIncrement();
+		}
+	}
+}
