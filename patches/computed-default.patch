+/*
+ * computed-default patch: true when a computed column expression reads no
+ * column and its only non-immutable parts are the current date/time functions
+ * (GETDATE(), GETUTCDATE(), SYSDATETIME(), SYSUTCDATETIME(),
+ * SYSDATETIMEOFFSET(), CURRENT_TIMESTAMP).
+ */
+typedef struct
+{
+	bool		time_fn;		/* a current date/time function was found */
+	bool		other_mutable;	/* some other non-immutable part was found */
+} ComputedDefaultContext;
+
+static bool
+computed_default_func_checker(Oid func_id, void *context)
+{
+	ComputedDefaultContext *c = (ComputedDefaultContext *) context;
+	char	   *name;
+
+	if (func_volatile(func_id) == PROVOLATILE_IMMUTABLE)
+		return false;
+	name = get_func_name(func_id);
+	if (name != NULL && get_func_namespace(func_id) == get_namespace_oid("sys", true) &&
+		(strcmp(name, "getdate") == 0 || strcmp(name, "getutcdate") == 0 ||
+		 strcmp(name, "sysdatetime") == 0 || strcmp(name, "sysutcdatetime") == 0 ||
+		 strcmp(name, "sysdatetimeoffset") == 0))
+	{
+		c->time_fn = true;
+		return false;
+	}
+	c->other_mutable = true;
+	return true;
+}
+
+static bool
+computed_default_walker(Node *node, void *context)
+{
+	ComputedDefaultContext *c = (ComputedDefaultContext *) context;
+
+	if (node == NULL)
+		return false;
+	if (check_functions_in_node(node, computed_default_func_checker, context))
+		return true;
+	if (IsA(node, SQLValueFunction))
+	{
+		switch (((SQLValueFunction *) node)->op)
+		{
+			case SVFOP_CURRENT_DATE:
+			case SVFOP_CURRENT_TIMESTAMP:
+			case SVFOP_CURRENT_TIMESTAMP_N:
+			case SVFOP_LOCALTIMESTAMP:
+			case SVFOP_LOCALTIMESTAMP_N:
+				c->time_fn = true;
+				return false;
+			default:
+				c->other_mutable = true;
+				return true;
+		}
+	}
+	if (IsA(node, NextValueExpr) || IsA(node, Param) || IsA(node, SubLink))
+	{
+		c->other_mutable = true;
+		return true;
+	}
+	return expression_tree_walker(node, computed_default_walker, context);
+}
+
+static bool
+computed_column_as_default(Node *expr)
+{
+	ComputedDefaultContext c = {false, false};
+
+	if (contain_var_clause(expr))
+		return false;
+	(void) computed_default_walker((Node *) expression_planner((Expr *) copyObject(expr)), &c);
+	return c.time_fn && !c.other_mutable;
+}
